{
  "name": "DiyDvrExtension",
  "displayName": "DIY DVR",
  "description": "Save data from a live Foxglove WebSocket connection to disk from a panel. Keep a rolling time- or size-bounded buffer and dump it to MCAP on demand, or auto-save each window as the limit is reached, then re-open the file for full scrub-back.",
  "publisher": "foxglove",
  "homepage": "https://github.com/foxglove/diy-dvr-panel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foxglove/diy-dvr-panel.git"
  },
  "bugs": "https://github.com/foxglove/diy-dvr-panel/issues",
  "version": "0.2.6",
  "license": "MIT",
  "main": "./dist/extension.js",
  "keywords": ["dvr", "recording", "buffer", "mcap", "websocket", "live"],
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "bundle:worker": "node scripts/bundle-worker.mjs",
    "build": "node scripts/bundle-worker.mjs && foxglove-extension build",
    "foxglove:prepublish": "node scripts/bundle-worker.mjs && foxglove-extension build --mode production",
    "validate:mcap": "node scripts/validate-mcap.mjs",
    "typecheck": "node scripts/bundle-worker.mjs && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:ci": "eslint .",
    "lint:fix": "eslint --fix .",
    "local-install": "node scripts/bundle-worker.mjs && foxglove-extension install",
    "package": "foxglove-extension package && node scripts/normalize-foxe.mjs",
    "registry-entry": "foxglove-extension publish"
  },
  "devDependencies": {
    "@foxglove/eslint-plugin": "2.1.0",
    "@foxglove/extension": "^2.53.1",
    "@types/jest": "^29.5.14",
    "@types/react": "18.2.17",
    "@types/react-dom": "18.2.7",
    "create-foxglove-extension": "^1.3.2",
    "eslint": "9.37.0",
    "eslint-plugin-react": "7.37.5",
    "jest": "^29.7.0",
    "prettier": "3.6.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "ts-jest": "^29.4.12",
    "typescript": "5.1.6"
  },
  "dependencies": {
    "@foxglove/rosmsg-msgs-common": "^3.2.3",
    "@foxglove/schemas": "^2.1.0",
    "@mcap/core": "^2.2.1",
    "esbuild": "^0.24.2"
  }
}
